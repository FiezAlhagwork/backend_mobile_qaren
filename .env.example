NODE_ENV=development
PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/qaren
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
SERPAPI_KEY=
GEMINI_API_KEY=

# اختياري — بلاه بينستعمل الافتراضي بـ src/config/env.js
# الحصة المجانية منفصلة لكل موديل. إذا صرت تاخد 429 كتير، بدّل الموديل هون
# بدل ما تنتظر تصفير الحصة. موديلات مجرَّبة وشغّالة مع الـ schema تبعنا:
#   gemini-3.1-flash-lite  (الافتراضي)
#   gemini-3.6-flash
#
# ⚠️ خلّيه مُعلَّق أو حطّ فيه قيمة — `GEMINI_MODEL=` فاضي بيوقف السيرفر عند
# الإقلاع، لأن الافتراضي بزود بيشتغل بس لما المتغيّر غير موجود إطلاقًا
# GEMINI_MODEL=gemini-3.1-flash-lite
